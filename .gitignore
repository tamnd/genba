/bin/
/dist/
*.out
*.test
coverage.out
.DS_Store

# What the latency gate writes out on every run. The baseline it compares
# against is checked in, this is the run that was compared against it.
/bench-report.json

# Local data directories a development server writes to.
/data/
*.db
*.db-shm
*.db-wal

# The Rust engine: its source checkout, its header and its static library.
# scripts/kura.sh puts them here. A checked in binary is a binary nobody can
# review and a build nobody can reproduce, so none of it is committed.
/third_party/

# Frontend build tooling. web/dist is checked in on purpose: it is what the
# binary embeds, so a clone builds a working server without a node toolchain.
/web/node_modules/
/web/.vite/
